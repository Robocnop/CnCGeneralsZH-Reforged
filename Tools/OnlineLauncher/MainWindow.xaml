<Window x:Class="ZHReforgedOnline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zero Hour Reforged Online" Width="1000" Height="640"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Background}" FontFamily="Segoe UI" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border BorderBrush="{StaticResource Divider}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Grid.Row="0" Background="{StaticResource HeaderBackground}" MouseLeftButtonDown="OnDragWindow">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <TextBlock Text="Zero Hour " FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Reforged" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <Border Background="{StaticResource Play}" CornerRadius="2" Margin="10,2,0,0" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="EN LIGNE" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#14161C"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleButton}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="OnMinimize" ToolTip="Réduire"/>
                    <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="OnClose" ToolTip="Fermer"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="520"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- artwork -->
                <Grid Grid.Column="0" ClipToBounds="True" Background="#05070D">
                    <Image x:Name="Artwork" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle HorizontalAlignment="Right" Width="80">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#000E1322" Offset="0"/>
                                <GradientStop Color="#FF0E1322" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- panel -->
                <Grid Grid.Column="1" Margin="34,30,30,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="INSTALLATION" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="StatusTitle" Text="Prêt à jouer" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Rectangle Height="1" Fill="{StaticResource Divider}"/>
                            <TextBlock Text="JEU" Style="{StaticResource SmallCaps}" Margin="0,12,0,0"/>
                            <TextBlock x:Name="GameVersion" Text="—" FontFamily="Consolas" FontSize="30" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="GameState" Text="" Style="{StaticResource Label}" FontWeight="Normal" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Rectangle Height="1" Fill="{StaticResource Divider}"/>
                            <TextBlock Text="LAUNCHER" Style="{StaticResource SmallCaps}" Margin="0,12,0,0"/>
                            <TextBlock x:Name="LauncherVersion" Text="v1.0.0" FontFamily="Consolas" FontSize="30" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,24,0,0">
                        <Rectangle Height="1" Fill="{StaticResource Divider}"/>
                        <TextBlock Text="MULTIJOUEUR EN LIGNE" Style="{StaticResource Label}" Margin="0,12,0,0"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="VOTRE CODE DE PARTIE" Style="{StaticResource SmallCaps}"/>
                                <TextBlock x:Name="MyCode" Text="…" FontFamily="Consolas" FontSize="26" Margin="0,2,0,0"/>
                                <TextBlock x:Name="MyCodeHint" Text="Recherche de votre adresse publique…" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="CopyButton" Grid.Column="1" Style="{StaticResource Link}" Content="Copier" VerticalAlignment="Center" Click="OnCopyCode" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,14,0,0">
                        <TextBlock Text="CODE DE L'AMI (OU SON IP)" Style="{StaticResource SmallCaps}"/>
                        <TextBox x:Name="FriendCode" Style="{StaticResource CodeBox}" Margin="0,4,0,0" MaxLength="21" TextChanged="OnFriendCodeChanged"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="HostButton" Grid.Column="0" Style="{StaticResource OutlineButton}" Content="Héberger en ligne" Click="OnHost"/>
                            <Button x:Name="JoinButton" Grid.Column="2" Style="{StaticResource OutlineButton}" Content="Rejoindre" Click="OnJoin" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>

                    <Button x:Name="PlayButton" Grid.Row="5" Style="{StaticResource PlayButton}" Content="Jouer" Click="OnPlay"/>

                    <Grid Grid.Row="6" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ReinstallButton" Style="{StaticResource Link}" Content="Réinstaller" Click="OnReinstall"/>
                            <TextBlock Text="  ·  " Foreground="{StaticResource Muted}"/>
                            <Button x:Name="FolderButton" Style="{StaticResource Link}" Content="Ouvrir le dossier" Click="OnOpenFolder"/>
                            <TextBlock Text="  ·  " Foreground="{StaticResource Muted}"/>
                            <Button x:Name="LanguageButton" Style="{StaticResource Link}" Content="Langue : Français" Click="OnLanguage"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
